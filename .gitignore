/target
/.obsidian
/.claude/
.playwright-mcp/
.DS_Store
# wasm-pack output for the web editor package — regenerated from crates/leaf-wasm
# by `npm run build:wasm` in packages/leaf-web, never committed.
/packages/leaf-web/pkg/

# SwiftPM/Xcode build dirs for the Swift package, whose manifest lives at the
# repo root. The UniFFI binding under packages/leaf-swift/uniffi-generated/ is
# COMMITTED (a version-resolved clone runs no generators) — regenerate it with
# scripts/gen-bindings.sh; CI diffs it against crates/leaf-ffi.
/.build/
/.swiftpm/
packages/leaf-swift/.build/
# Xcode's own build directory for the package (distinct from SwiftPM's `.build`),
# left behind when apps/leaf-editor is built against it as a local package.
packages/leaf-swift/build/
packages/leaf-swift/.swiftpm/xcode/xcuserdata/adamharris.xcuserdatad/xcschemes/
.env
