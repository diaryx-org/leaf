# What ship needs to know about leaf: its release, and its CI. Everything not
# stated here is ship's default — the manifest, the changelog path, the cliff
# config, and that this is a Cargo workspace.
name = leaf
url = https://github.com/diaryx-org/leaf
release_branch = main

# No `verify`: before cutting, a release runs the jobs below.

# Not on crates.io: leaf is consumed from git, by commit, so a tag is a name
# for a commit and the start of whatever else is listed below.
publishes = false

# What pushing the tag sets off, most consequential first. The warning printed
# before the push is handed back to you is composed from these.
tag_starts
> *
> > workflow = mac-app.yml
> > does = builds, signs and notarises Leaf.app, attaches its disk image to the release, and writes the tap's `leaf-editor` cask
> *
> > workflow = pages.yml
> > does = builds Leaf for the browser (`cargo xtask web`) and deploys it to https://diaryx-org.github.io/leaf/, in place of what is there

# The checks a release has to pass. `ship ci` runs them here, in this order,
# with the same shell, and stops at the first that fails; `ship ci <id>` runs
# one. No GitHub workflow runs them.
#
# A job is `id` (what `ship ci <id>` takes), `name` (the heading a full run
# prints) and `run` (run by `bash -eo pipefail -c` at the repository root).
# Cheapest and most likely to fail first, so the run that is going to fail
# fails in seconds rather than after everything compiles.
job
> *
> > id = fmt
> > name = Format
> > run = cargo fmt --all --check
> *
> > # Warnings are errors here because they are errors in review — a lint that
> > # only fires on someone else's machine is a lint found too late. The Dioxus
> > # widget is linted without `system-clipboard` too (its renderer, `vello`,
> > # turned back on: dioxus-native needs one), the shape a host with its own
> > # clipboard builds.
> > id = clippy
> > name = Clippy
> > run = cargo clippy --workspace --all-targets -- -D warnings && cargo clippy -p leaf-dioxus --all-targets --no-default-features --features vello -- -D warnings
> *
> > # Includes the xtask's own tests: that the two frontend bindings export the
> > # same methods, and that every workspace member is checked alone below.
> > id = test
> > name = Test
> > run = cargo test --workspace
> *
> > # Workspace feature unification means `cargo check --workspace` can pass
> > # when a crate cannot compile on its own, so each crate is checked alone, in
> > # each feature shape a host builds. The list is in the xtask.
> > id = package-isolation
> > name = Package isolation
> > run = cargo xtask package-isolation
> *
> > # The web host (apps/leaf-dioxus-web, the editor in a browser tab) and
> > # the widget as it builds there: for `wasm32-unknown-unknown`, without the
> > # system clipboard, on Blitz's hybrid renderer, with its Mermaid split
> > # point. Off the web the host is empty, so the jobs above see none of it.
> > # Linted only: it runs in a browser, which `cargo test` has none of, and
> > # its split build (`cargo xtask web`) is slow; its README says how to try
> > # it. Last because it compiles Blitz and wgpu for another target: the
> > # slowest job, and the least likely to be the one that fails.
> > id = web
> > name = Dioxus web host
> > run = cargo clippy -p leaf-dioxus-web --target wasm32-unknown-unknown --all-targets -- -D warnings && cargo clippy -p leaf-dioxus --target wasm32-unknown-unknown --no-default-features --features dioxus-native/vello-hybrid,wasm-split -- -D warnings
