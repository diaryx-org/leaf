# What ship needs to know about leaf: its release, and its CI. Everything not
# stated here is ship's default — the manifest, the changelog path, the cliff
# config, and that this is a Cargo workspace.
name = leaf
url = https://github.com/diaryx-org/leaf
release_branch = main

# No `verify`: before cutting, a release runs the jobs below.

# The Dioxus apps' manifests (each a workspace of its own) follow the
# workspace version, and ship's bump of the root workspace does not reach them
# — so the bump runs the task that writes them, and the files are staged with
# the release commit. The `versions` job checks they agree.
post_bump = cargo xtask sync-versions

extra_version_files = [
  apps/leaf-dioxus/Cargo.toml,
  apps/leaf-dioxus-tui/Cargo.toml,
]

# Not on crates.io: leaf is consumed from git, by commit, so a tag is a name
# for a commit and the start of whatever else is listed below.
publishes = false

# What pushing the tag sets off, most consequential first. The warning printed
# before the push is handed back to you is composed from these.
tag_starts
> *
> > workflow = mac-app.yml
> > does = builds, signs and notarises Leaf.app, attaches its disk image to the release, and writes the tap's `leaf-editor` cask

# The checks a release has to pass. `ship ci` runs them here, in this order,
# with the same shell, and stops at the first that fails; `ship ci <id>` runs
# one. No GitHub workflow runs them.
#
# A job is `id` (what `ship ci <id>` takes), `name` (the heading a full run
# prints) and `run` (run by `bash -eo pipefail -c` at the repository root).
# Cheapest and most likely to fail first, so the run that is going to fail
# fails in seconds rather than after everything compiles.
job
> *
> > # The Dioxus apps state the workspace version.
> > id = versions
> > name = Versions
> > run = cargo xtask sync-versions --check
> *
> > id = fmt
> > name = Format
> > run = cargo fmt --all --check
> *
> > # Warnings are errors here because they are errors in review — a lint that
> > # only fires on someone else's machine is a lint found too late.
> > id = clippy
> > name = Clippy
> > run = cargo clippy --workspace --all-targets -- -D warnings
> *
> > # Includes the xtask's own tests: that the two frontend bindings export the
> > # same methods, and that every workspace member is checked alone below.
> > id = test
> > name = Test
> > run = cargo test --workspace
> *
> > # Workspace feature unification means `cargo check --workspace` can pass
> > # when a crate cannot compile on its own, so each crate is checked alone, in
> > # each feature shape a host builds. The list is in the xtask.
> > id = package-isolation
> > name = Package isolation
> > run = cargo xtask package-isolation
> *
> > # The Dioxus widget and the app over it (apps/leaf-dioxus, Leaf for the
> > # Mac, its menus and dialogs from diaryx-org/unit), each a workspace of its
> > # own (an alpha Dioxus; the app's winit is patched, the others' are not),
> > # so nothing above reaches them. The widget is linted without
> > # `system-clipboard` too (its renderer, `vello`, turned back on:
> > # dioxus-native needs one), the shape a host with its own clipboard builds.
> > # Last because it compiles Blitz and wgpu: the slowest job, and the least
> > # likely to be the one that fails.
> > id = dioxus
> > name = Dioxus widget and app
> > run = cargo fmt --manifest-path crates/leaf-dioxus/Cargo.toml --check && cargo clippy --manifest-path crates/leaf-dioxus/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path crates/leaf-dioxus/Cargo.toml --all-targets --no-default-features --features vello -- -D warnings && cargo test --manifest-path crates/leaf-dioxus/Cargo.toml && cargo fmt --manifest-path apps/leaf-dioxus/Cargo.toml --check && cargo clippy --manifest-path apps/leaf-dioxus/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path apps/leaf-dioxus/Cargo.toml
